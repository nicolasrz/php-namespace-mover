{
  "name": "php-refactor-kit",
  "displayName": "PHP Refactor Kit",
  "description": "Refactorings PHP façon PhpStorm : namespace mis à jour au déplacement de fichier, implémentation des méthodes d’interface.",
  "version": "0.1.0",
  "publisher": "nicolasrz",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/composer.json",
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "PHP Refactor Kit",
      "properties": {
        "phpRefactorKit.namespace.updateOnMove": {
          "type": "boolean",
          "default": true,
          "description": "Mettre à jour les namespaces lors d'un déplacement de fichier PHP."
        },
        "phpRefactorKit.namespace.exclude": {
          "type": "string",
          "default": "**/{vendor,node_modules,var,.git}/**",
          "description": "Glob des fichiers ignorés lors de la mise à jour des références."
        },
        "phpRefactorKit.namespace.referenceFiles": {
          "type": "string",
          "default": "**/*.{yaml,yml,xml,neon}",
          "description": "Fichiers non-PHP dans lesquels remplacer les FQCN (config Symfony, mappings Doctrine…). Vide pour désactiver."
        },
        "phpRefactorKit.namespace.preview": {
          "type": "boolean",
          "default": false,
          "description": "Afficher l'aperçu de refactoring avant d'appliquer les modifications."
        },
        "phpRefactorKit.namespace.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Enregistrer les fichiers modifiés."
        },
        "phpRefactorKit.implement.methodBody": {
          "type": "string",
          "default": "throw new \\LogicException('Not implemented.');",
          "description": "Corps des méthodes générées."
        }
      }
    },
    "commands": [
      {
        "command": "phpRefactorKit.implementMethods",
        "title": "Implémenter les méthodes",
        "category": "PHP"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phpRefactorKit.implementMethods",
          "when": "editorLangId == php"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasrz/php-refactor-kit"
  }
}
