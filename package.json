{
  "name": "php-refactor-kit",
  "displayName": "PHP Refactor Kit",
  "description": "PhpStorm-like PHP refactorings: update namespaces when moving files, implement interface methods, remove unused imports.",
  "version": "0.2.0",
  "publisher": "nicolasrz",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#4F5B93",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasrz/php-refactor-kit"
  },
  "homepage": "https://github.com/nicolasrz/php-refactor-kit#readme",
  "bugs": {
    "url": "https://github.com/nicolasrz/php-refactor-kit/issues"
  },
  "keywords": [
    "php",
    "namespace",
    "psr-4",
    "refactor",
    "refactoring",
    "phpstorm",
    "move",
    "symfony",
    "laravel",
    "implement",
    "interface",
    "composer",
    "imports",
    "unused",
    "organize imports"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/composer.json",
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "PHP Refactor Kit",
      "properties": {
        "phpRefactorKit.namespace.updateOnMove": {
          "type": "boolean",
          "default": true,
          "description": "Update namespaces when a PHP file or folder is moved."
        },
        "phpRefactorKit.namespace.exclude": {
          "type": "string",
          "default": "**/{vendor,node_modules,var,.git}/**",
          "description": "Glob of files ignored when updating references."
        },
        "phpRefactorKit.namespace.referenceFiles": {
          "type": "string",
          "default": "**/*.{yaml,yml,xml,neon}",
          "description": "Non-PHP files in which FQCNs are replaced (Symfony config, Doctrine mappings…). Empty to disable."
        },
        "phpRefactorKit.namespace.preview": {
          "type": "boolean",
          "default": false,
          "description": "Show the refactoring preview before applying changes."
        },
        "phpRefactorKit.namespace.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Save modified files."
        },
        "phpRefactorKit.implement.methodBody": {
          "type": "string",
          "default": "throw new \\LogicException('Not implemented.');",
          "description": "Body of generated methods."
        }
      }
    },
    "commands": [
      {
        "command": "phpRefactorKit.menu",
        "title": "Menu",
        "category": "PHP Refactor Kit"
      },
      {
        "command": "phpRefactorKit.implementMethods",
        "title": "Implement methods",
        "category": "PHP Refactor Kit"
      },
      {
        "command": "phpRefactorKit.removeUnusedImports",
        "title": "Remove unused imports",
        "category": "PHP Refactor Kit"
      },
      {
        "command": "phpRefactorKit.fixNamespace",
        "title": "Fix namespace",
        "category": "PHP Refactor Kit"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phpRefactorKit.menu",
          "when": "editorLangId == php"
        },
        {
          "command": "phpRefactorKit.implementMethods",
          "when": "editorLangId == php"
        },
        {
          "command": "phpRefactorKit.removeUnusedImports",
          "when": "editorLangId == php"
        },
        {
          "command": "phpRefactorKit.fixNamespace",
          "when": "editorLangId == php"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
